  "components": {
    "securitySchemes": {
      "leadershipCode": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal high-entropy leadership access code."
      }
    },
    "schemas": {
      "Member": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string"
          },
          "regNo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "presence": {
            "type": "string",
            "enum": [
              "inside",
              "outside",
              "unknown"
            ]
          },
          "lastEventAt": {
            "type": "string",
            "nullable": true
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visitCount": {
            "type": "integer",
            "minimum": 0
          },
          "completedVisits": {
            "type": "integer",
            "minimum": 0
          },
          "completedMinutes": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "memberId",
          "regNo",
          "name",
          "branch",
          "presence",
          "lastEventAt",
          "flags",
          "visitCount",
          "completedVisits",
          "completedMinutes"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CHECK-IN",
              "CHECK-OUT"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRow": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "id",
          "occurredAt",
          "action",
          "flags",
          "sourceRow"
        ]
      },
      "Visit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "checkInAt": {
            "type": "string"
          },
          "checkOutAt": {
            "type": "string",
            "nullable": true
          },
          "confirmedDurationMinutes": {
            "type": "number",
            "minimum": 0,
            "nullable": true
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "checkInAt",
          "checkOutAt",
          "confirmedDurationMinutes",
          "flags"
        ]
      },
      "Quality": {
        "type": "object",
        "properties": {
          "invalidRows": {
            "type": "integer",
            "minimum": 0
          },
          "testExclusions": {
            "type": "integer",
            "minimum": 0
          },
          "exactDuplicates": {
            "type": "integer",
            "minimum": 0
          },
          "conflictingIds": {
            "type": "integer",
            "minimum": 0
          },
          "identityConflicts": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "invalidRows",
          "testExclusions",
          "exactDuplicates",
          "conflictingIds",
          "identityConflicts"
        ]
      },
      "Meta": {
        "type": "object",
        "properties": {
          "snapshotId": {
            "type": "string"
          },
          "sourceReadAt": {
            "type": "string"
          },
          "servedAt": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string",
            "enum": [
              "Asia/Kolkata"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "live"
            ]
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "insideCount": {
            "type": "integer",
            "minimum": 0
          },
          "memberCount": {
            "type": "integer",
            "minimum": 0
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "snapshotId",
          "sourceReadAt",
          "servedAt",
          "stale",
          "timezone",
          "mode",
          "quality"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "MemberList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "meta",
          "nextCursor"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Member"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "meta",
          "nextCursor"
        ]
      },
      "EventList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "meta",
          "nextCursor"
        ]
      },
      "VisitList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Visit"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "meta",
          "nextCursor"
        ]
      }
    }
  }
