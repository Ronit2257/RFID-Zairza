    "create-access": "node --import tsx scripts/create-access.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
