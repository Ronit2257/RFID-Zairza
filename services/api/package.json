{
  "name": "@zairza/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --import tsx test/domain.test.ts && node --import tsx test/api.test.ts && node --import tsx test/contract.test.ts",
